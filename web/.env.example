# Copy to .env.local (gitignored). Any ONE model-provider key is enough to run;
# keys can also be entered in the app under Instellingen (stored server-side).

# --- Model providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_RESOURCE_NAME=
# Any OpenAI-compatible endpoint (OpenRouter, Groq, Together, vLLM, Ollama = http://localhost:11434/v1)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# --- Read-aloud (optional) ---
ELEVENLABS_API_KEY=

# --- Workspace ---
MUNICIPALITY_NAME=Schoten
RETRIEVAL_CHAR_BUDGET=60000
# Use off with transports without SSE, such as Cloudflare Quick Tunnels.
# The server selects the transport before starting generation.
APP_STREAMING=on

# --- Access gate (leave password empty for local use) ---
# Set BOTH credentials before making the workspace public. Prefer a long,
# randomly generated workspace password. Whitespace-only passwords fail closed.
# Secret: at least 32 printable ASCII characters, no spaces, at least 8 distinct
# characters, and different from APP_PASSWORD. Generate 32 random bytes, e.g.:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Missing/weak secret with a configured password returns safe 503 responses.
APP_PASSWORD=
APP_SESSION_SECRET=
# ea_session = v1.<issued-at Unix seconds>.<HMAC-SHA256 hex>; the signing key
# derives from BOTH credentials. Server-enforced lifetime: 12h, not sliding.
# HttpOnly, SameSite=Strict, Path=/, Secure over HTTPS. Credential changes revoke
# old sessions. In local mode without APP_PASSWORD, a valid login POST clears
# the cookie (204). Cloudflare mode requires BOTH credentials or returns 503.
#
# local (default): do not trust client-IP forwarding headers. NextRequest has
# no socket IP, so all local clients share one conservative rate-limit bucket.
# Only Host localhost, 127.0.0.1 or [::1] is accepted (any valid port). LAN IPs
# and other hostnames are deliberately rejected, preventing DNS rebinding.
# cloudflare: ONLY when Next binds 127.0.0.1/::1 and cloudflared is the sole
# public ingress. Never expose that Node port to the LAN/Internet in this mode.
# Cloudflare must preserve Host and overwrite CF-Connecting-IP/X-Forwarded-Proto.
# Validated CF-Connecting-IP supplies the public client identity; a single exact
# http/https X-Forwarded-Proto supplies cookie security and same-origin scheme.
# Direct loopback requests without CF-Connecting-IP use the local fallback and
# the same local Host restrictions; arbitrary public hosts without CF fail.
# X-Forwarded-For, X-Real-IP, Forwarded and X-Forwarded-Host are never trusted.
# Origin on unsafe methods must match actual Host + scheme (curl without Origin
# is supported); do not configure a cloudflared Host override.
APP_TRUST_PROXY=local
# One process only: model-bearing POSTs share 10 tokens/IP, refilling at 10/min;
# login has a separate 5/IP/min bucket. Each family also has a 100/min workspace
# ceiling. 429 includes Retry-After (seconds until a token is available).
# Maps survive HMR, cap at 2048 clients/family, expire after 5 minutes idle and
# reset on process restart. No distributed quota or account/role management.
