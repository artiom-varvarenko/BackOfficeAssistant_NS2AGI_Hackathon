# Copy to .env.local (gitignored). Any ONE model-provider key is enough to run;
# keys can also be entered in the app under Instellingen (stored server-side).

# --- Model providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_RESOURCE_NAME=
# Any OpenAI-compatible endpoint (OpenRouter, Groq, Together, vLLM, Ollama = http://localhost:11434/v1)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=

# --- Read-aloud (optional) ---
ELEVENLABS_API_KEY=

# --- Workspace ---
MUNICIPALITY_NAME=Schoten
RETRIEVAL_CHAR_BUDGET=60000

# --- Access gate (leave empty for local use; set both to expose via a tunnel) ---
APP_PASSWORD=
APP_SESSION_SECRET=
